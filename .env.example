# Owmee — environment variables
# Copy to .env and fill in YOUR_* values. .env is in .gitignore.

# ── Application ─────────────────────────────────────────────────────────
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# App secret — generate with: openssl rand -hex 32
SECRET_KEY=YOUR_APP_SECRET_32_CHARS_OR_MORE

# JWT signing keys
# Development: if these are blank and ./keys/*.pem is missing, the backend
# generates a local ignored keypair automatically.
# Production/Render: set JWT_PRIVATE_KEY and JWT_PUBLIC_KEY as escaped
# single-line env vars, or mount files and set the *_PATH values below.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# ── Database ────────────────────────────────────────────────────────────
POSTGRES_USER=owmee
POSTGRES_PASSWORD=owmee_dev_password
POSTGRES_DB=owmee
DATABASE_URL=postgresql+asyncpg://owmee:owmee_dev_password@postgres:5432/owmee
SYNC_DATABASE_URL=postgresql://owmee:owmee_dev_password@postgres:5432/owmee
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Async media processing ──────────────────────────────────────────────
HERO_CLEANUP_WORKER_CONCURRENCY=2
HERO_CLEANUP_ENQUEUE_TIMEOUT_SECONDS=0.5
HERO_CLEANUP_STREAM_MAXLEN=50000
HERO_CLEANUP_RETRY_MAX_ATTEMPTS=4
HERO_CLEANUP_PENDING_IDLE_SECONDS=180
HERO_CLEANUP_READ_BLOCK_MS=2000

# ── MinIO ───────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
R2_BUCKET=owmee-media
R2_REGION=auto
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin

R2_ENDPOINT=http://minio:9000

# Public endpoint (baked into presigned URLs the mobile app uses)
# Replace YOUR_LAN_IP with your dev machine's actual LAN IP.
# macOS: ifconfig | grep "inet " | grep -v 127.0.0.1
# Linux: hostname -I | awk '{print $1}'
R2_PUBLIC_ENDPOINT=http://YOUR_LAN_IP:9000
R2_PUBLIC_URL=http://YOUR_LAN_IP:9000

# ── Temporal ───────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# ── Gemini ─────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
# Defaults below use the latest Gemini 3 preview family. Pin to stable
# Gemini 2.5 models (gemini-2.5-pro / gemini-2.5-flash) if stability
# matters more than latest-model capability.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_VISION_MODEL=gemini-3-pro-preview
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
IMAGE_CLEANUP_PROVIDER=gemini

# ── KYC providers (mocked in dev, Digio/Karza/Signzy/IDfy in prod) ─────
KYC_PARTNER=mock
KYC_PARTNER_API_KEY=
KYC_PARTNER_BASE_URL=
KYC_WEBHOOK_SECRET=

# ── Payment partner (mocked in dev, Razorpay in prod) ──────────────────
PA_PROVIDER=mock
PA_KEY_ID=
PA_KEY_SECRET=
PA_WEBHOOK_SECRET=

# ── Notifications ──────────────────────────────────────────────────────
PUSH_PROVIDER=fcm
FCM_SERVER_KEY=
SMS_PROVIDER=mock
SMS_API_BASE_URL=https://control.msg91.com
SMS_API_KEY=
SMS_TEMPLATE_ID=

# ── Geocoding ──────────────────────────────────────────────────────────
GEOCODING_PROVIDER=photon
PHOTON_URL=https://photon.komoot.io
PHOTON_TIMEOUT_SECONDS=6

# ── Feature flags ──────────────────────────────────────────────────────
ENABLE_AI_LISTING=true
ENABLE_FIELD_EXECUTIVE=false
ENABLE_COMMUNITY=false

# ── Dev conveniences ───────────────────────────────────────────────────
DEV_OTP_BYPASS=true
DEV_KYC_BYPASS=true
DEV_FIXED_OTP=123456
