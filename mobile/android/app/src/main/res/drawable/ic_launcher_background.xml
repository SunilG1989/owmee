<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback adaptive-icon background. Density-specific bitmap backgrounds are
  generated in drawable-* folders for production launchers; this XML remains as
  a resilient fallback if a density-specific asset is unavailable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#BAE5D3"
        android:centerColor="#FFA25A"
        android:endColor="#EE6F27" />
</shape>
