<resources>

    <!-- Base application theme — what the React root view runs under. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!--
        Cold-start launch theme. Applied on the launcher activity in
        AndroidManifest.xml; MainActivity swaps to AppTheme in onCreate
        so the splash window background is dropped before React mounts.
        The status/nav bars match the splash bg so there's no seam.

        Android 12+ renders a system splash before the activity window, so
        every stage must share the same plain field to avoid a double-splash.
    -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/owmee_splash_icon_system</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

</resources>
