<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (Android 8.0+). Without this, launchers that mask icons (Pixel
  masks to a circle) fall back to "legacy icon treatment" and shrink the square
  bitmap onto a neutral background inside the mask — the square-in-a-circle bug.
  The foreground is the full-bleed brand mark, so the circle mask crops it to a
  clean round icon; the gradient background only shows in the parallax sliver.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
