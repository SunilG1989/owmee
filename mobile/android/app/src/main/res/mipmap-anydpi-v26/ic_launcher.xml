<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (Android 8.0+). The color icon is split into Android's
  production launcher model: an opaque background layer plus a transparent
  foreground mark centered in the safe zone. Keep the foreground generated from
  the approved brand artwork; do not use a finished square bitmap here.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
