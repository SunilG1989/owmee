<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (Android 8.0+). Keep the Owmee mark in the foreground layer
  with transparent outer padding, and keep the soft gradient field in the
  background layer. Do not bake the fixed rounded-square border into the
  adaptive foreground; launchers mask adaptive icons into OEM-specific shapes.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
