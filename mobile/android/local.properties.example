# Copy this file to mobile/android/local.properties on your machine.
# Do not commit local.properties because it contains machine paths and secrets.

# Android SDK path, normally generated by Android Studio:
# sdk.dir=/Users/dev/Library/Android/sdk

# Required for Android release builds. Enable "Maps SDK for Android" in Google
# Cloud and inject this through CI secrets, an environment variable, a Gradle
# property, or this local file.
#
# Restrict the Android key in Google Cloud to:
# - Package name: com.owmee
# - SHA-1 certificate fingerprint for the release/upload key used to sign the APK/AAB.
#   To inspect the current local signing fingerprints, run:
#   cd mobile/android && ./gradlew signingReport
GOOGLE_MAPS_API_KEY=YOUR_ANDROID_MAPS_API_KEY

# Non-production escape hatch only. Never use this for a build sent to users.
# ALLOW_MISSING_GOOGLE_MAPS_API_KEY=true

# CI/prod release signing. Production builds should set REQUIRE_RELEASE_SIGNING=true
# and provide these values from CI secrets.
# OWMEE_RELEASE_STORE_FILE=/absolute/path/to/owmee-upload-key.jks
# OWMEE_RELEASE_STORE_PASSWORD=...
# OWMEE_RELEASE_KEY_ALIAS=...
# OWMEE_RELEASE_KEY_PASSWORD=...
# REQUIRE_RELEASE_SIGNING=true
