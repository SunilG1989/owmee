# ── Owmee Backend Configuration ──────────────────────────────────────────────
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── Environment ──────────────────────────────────────────────────────────────
ENV=development  # development | production

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://owmee:owmee_dev_password@postgres:5432/owmee
SYNC_DATABASE_URL=postgresql://owmee:owmee_dev_password@postgres:5432/owmee
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:owmee_redis_password@redis:6379/0

# ── Async media processing ────────────────────────────────────────────────────
HERO_CLEANUP_WORKER_CONCURRENCY=2
HERO_CLEANUP_ENQUEUE_TIMEOUT_SECONDS=0.5
HERO_CLEANUP_STREAM_MAXLEN=50000
HERO_CLEANUP_RETRY_MAX_ATTEMPTS=4
HERO_CLEANUP_PENDING_IDLE_SECONDS=180
HERO_CLEANUP_READ_BLOCK_MS=2000
AI_DRAFT_ANALYSIS_WORKER_CONCURRENCY=1
AI_DRAFT_ANALYSIS_STREAM_MAXLEN=50000
AI_DRAFT_ANALYSIS_RETRY_MAX_ATTEMPTS=3
AI_DRAFT_ANALYSIS_READ_BLOCK_MS=2000
AI_DRAFT_FAST_PATH_ENABLED=true
AI_DRAFT_FULL_FALLBACK_ENABLED=true
AI_DRAFT_SHADOW_FULL_ANALYSIS_ENABLED=false
AI_DRAFT_FAST_MIN_CATEGORY_CONFIDENCE=0.55

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233          # local dev
# TEMPORAL_HOST=your-namespace.tmprl.cloud:7233  # Temporal Cloud
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=                    # Temporal Cloud API key (leave empty for local)

# ── JWT / Security ────────────────────────────────────────────────────────────
# Production/Render: prefer inline escaped PEM values in JWT_PRIVATE_KEY and
# JWT_PUBLIC_KEY. Local Docker can use mounted key files.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
SECRET_KEY=change_me_in_production_use_secrets_module

# ── Object Storage (Cloudflare R2 or MinIO) ───────────────────────────────────
# Dev: MinIO (local Docker container)
R2_ENDPOINT=http://minio:9000
R2_BUCKET=owmee-media
R2_EVIDENCE_BUCKET=owmee-evidence
R2_ACCESS_KEY=owmee_minio_user
R2_SECRET_KEY=owmee_minio_password
# Public object base URL for display. In production, use the R2 public bucket
# URL or custom domain, for example https://media.owmee.in.
R2_PUBLIC_URL=http://localhost:9000
# S3-compatible endpoint reachable by phones/browsers for presigned PUT/GET.
R2_PUBLIC_ENDPOINT=http://localhost:9000

# Production: Cloudflare R2
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=owmee-media
# R2_EVIDENCE_BUCKET=owmee-evidence
# R2_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# R2_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# R2_PUBLIC_URL=https://media.owmee.in
# R2_PUBLIC_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ── SMS OTP (production only) ─────────────────────────────────────────────────
SMS_PROVIDER=mock          # mock | msg91 | gupshup
SMS_API_BASE_URL=https://control.msg91.com
SMS_API_KEY=               # MSG91: authkey, Gupshup: userid
SMS_SENDER_ID=OWMAPP       # 6-char DLT-registered sender ID
SMS_DLT_ENTITY_ID=         # DLT entity ID from TRAI portal
SMS_TEMPLATE_ID=
# MSG91: set the OTP-section template_id here. The template must contain ##OTP##.
SMS_MSG91_TIMEOUT_SECONDS=10
SMS_MSG91_OTP_EXPIRY_MINUTES=10
# Gupshup: also set password (same as userid for basic auth)

# ── KYC Partner (Digio / Karza / Signzy / IDfy) ──────────────────────────────
KYC_PARTNER=mock           # mock | digio | karza | signzy | idfy
KYC_PARTNER_API_KEY=       # Partner API key
KYC_PARTNER_BASE_URL=https://ext.digio.in:444
KYC_WEBHOOK_SECRET=        # Webhook signature secret for partner callbacks

# ── Fraud / Risk Decisioning (Bureau) ────────────────────────────────────────
FRAUD_PROVIDER=mock        # mock | bureau
FRAUD_API_BASE_URL=
FRAUD_API_KEY=
FRAUD_WEBHOOK_SECRET=
FRAUD_ONBOARDING_PATH=/v1/onboarding/check
FRAUD_TIMEOUT_SECONDS=3
FRAUD_DECISION_VALID_DAYS=30
FRAUD_ENFORCEMENT_ENABLED=true
HIGH_VALUE_VERIFICATION_THRESHOLD_INR=10000

# ── Payment Aggregator (Razorpay) ─────────────────────────────────────────────
PA_PROVIDER=mock           # mock | razorpay | cashfree | payu
PA_KEY_ID=                 # Razorpay key_id (rzp_test_* or rzp_live_*)
PA_KEY_SECRET=             # Razorpay key_secret
PA_WEBHOOK_SECRET=         # Razorpay webhook signature secret

# ── Push Notifications (FCM) ──────────────────────────────────────────────────
PUSH_PROVIDER=fcm          # fcm | noop
FCM_SERVER_KEY=            # Firebase Cloud Messaging server key
# Get from: Firebase Console → Project Settings → Cloud Messaging → Server key
# APNs (iOS, not needed for Android-only launch)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_PATH=/app/keys/apns_key.p8

# ── Chat (Stream Chat) ────────────────────────────────────────────────────────
STREAM_API_KEY=            # From getstream.io dashboard
STREAM_API_SECRET=         # From getstream.io dashboard

# ── Logistics ─────────────────────────────────────────────────────────────────
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_WEBHOOK_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=                # Sentry DSN for error tracking (optional)
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000

# ── AI listing assist ─────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.0-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
IMAGE_CLEANUP_PROVIDER=gemini

# ── Geocoding ─────────────────────────────────────────────────────────────────
GEOCODING_PROVIDER=photon
PHOTON_URL=https://photon.komoot.io
PHOTON_TIMEOUT_SECONDS=6

# ── Rate limiting ─────────────────────────────────────────────────────────────
OTP_RATE_LIMIT_PER_HOUR=3
OTP_MAX_ATTEMPTS=5
